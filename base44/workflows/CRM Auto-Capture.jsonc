{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_auto_capture",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_contact": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onUserSignup",
            "args": {
              "user_id": "${ .trigger.user_id }",
              "email": "${ .trigger.email }",
              "full_name": "${ .trigger.full_name }",
              "auth_method": "${ .trigger.auth_method }",
              "event_type": "${ .trigger.event_type }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create CRM contact",
            "description": "Auto-capture signup in CRM + sync to Drive/Supabase"
          }
        }
      }
    ]
  },
  "description": "Creates a CRM Contact for every signup/login and syncs to Google Drive + Supabase",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup",
        "login"
      ]
    }
  },
  "name": "CRM Auto-Capture"
}