{
  "name": "SERP Competitor Cloner",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "serp_competitor_cloner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "clone_competitors": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCloneSerpCompetitors",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Clone Top SERP Competitors",
            "description": "Find and clone top-ranking sites for all portfolio keywords across all active domains"
          }
        }
      }
    ]
  },
  "description": "Weekly: auto-clone top-ranking competitors for all portfolio keywords, extract their ranking blueprints, and identify content gaps to exploit"
}