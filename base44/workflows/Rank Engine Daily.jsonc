{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rank_engine_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_engine": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRankEngine",
            "args": {
              "action": "run"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Rank Engine",
            "description": "SEO execution cycle for active campaign"
          }
        }
      }
    ]
  },
  "description": "Runs the autonomous SEO execution engine daily across active campaigns \u2014 keyword discovery, programmatic pages, citations, and technical audits.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Rank Engine Daily"
}