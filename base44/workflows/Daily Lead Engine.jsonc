{
  "name": "Daily Lead Engine",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_lead_engine",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "scrape_sources": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scrapeLeadSources",
            "args": {
              "max_sources": 10,
              "triggered_by": "workflow"
            }
          },
          "then": "validate_leads",
          "x-base44": {
            "title": "Scrape all lead sources",
            "description": "Facebook, Craigslist, Reddit, building depts, company directories \u2014 captures screenshots + uses cookie auth"
          }
        }
      },
      {
        "validate_leads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "validateLeads",
            "args": {
              "triggered_by": "workflow"
            }
          },
          "then": "enrich_hot_leads",
          "x-base44": {
            "title": "Validate leads \u2014 spam detection + intent tier + opportunity type classification",
            "description": "Validator agent classifies each lead (HOT/WARM/PARTNER/PROJECT/SIGNAL), assigns opportunity type (DIRECT_DEMAND/PROBLEM_DEMAND/PROJECT_DEMAND/BID_DEMAND/PARTNER_DEMAND/PROPERTY_SIGNAL), flags spam, sets review_status"
          }
        }
      },
      {
        "enrich_hot_leads": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enrichHotLead",
            "args": {
              "triggered_by": "workflow",
              "max_depth": 2
            }
          },
          "then": "send_initial_outreach",
          "x-base44": {
            "title": "Enrich HOT leads \u2014 build lead graph",
            "description": "Investigate HOT/VERY_HOT leads deeply: company \u2192 website \u2192 project \u2192 property \u2192 GC \u2192 architect \u2192 developer \u2192 permits \u2192 bid documents. Creates LeadRelationship nodes in the lead graph."
          }
        }
      },
      {
        "send_initial_outreach": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLeadOutreach",
            "args": {
              "template_type": "hello",
              "max_sends": 15,
              "follow_up_only": false
            }
          },
          "then": "send_follow_ups",
          "x-base44": {
            "title": "Send initial outreach emails",
            "description": "Hello + brochure + 10% off coupon to new company leads (tier-routed by Diplomat)"
          }
        }
      },
      {
        "send_follow_ups": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLeadOutreach",
            "args": {
              "follow_up_only": true,
              "max_sends": 10
            }
          },
          "then": "send_digest",
          "x-base44": {
            "title": "Send follow-up emails",
            "description": "Follow-ups to leads in the outreach sequence"
          }
        }
      },
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendLeadDigest",
            "args": {
              "triggered_by": "workflow"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send 5am morning digest",
            "description": "Analyst agent generates the morning briefing \u2014 HOT/VERY_HOT leads, source performance, action items"
          }
        }
      }
    ]
  },
  "description": "Daily 5am ET lead engine: scrape all sources \u2192 validate (spam + intent tier + opportunity type) \u2192 enrich HOT leads (build lead graph) \u2192 send initial outreach \u2192 send follow-ups \u2192 email the morning digest. Tier-routed outreach: HOT/VERY_HOT same-day, WARM standard sequence, PARTNER subcontractor angle, PROJECT/PROPERTY nurture.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}