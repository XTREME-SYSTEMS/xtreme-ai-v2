{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Weekly Price Optimization",
  "description": "Runs competitor platform analysis weekly to identify pricing gaps and recommend cheaper+better product alternatives. Persists results as a Receipt for team review.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_price_optimization",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "optimize_prices": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runPriceOptimization",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run competitor price analysis",
            "description": "Analyze competitor platforms and save pricing recommendations"
          }
        }
      }
    ]
  }
}