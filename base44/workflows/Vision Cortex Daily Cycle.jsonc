{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vision_cortex_daily_cycle",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "discover": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "visionCortexDiscover",
            "args": {
              "max_sources": 4,
              "max_ideas_per_source": 8,
              "max_total": 25,
              "triggered_by": "workflow"
            }
          },
          "then": "validate",
          "x-base44": {
            "title": "Discover 25 ideas",
            "description": "Scrape Reddit, Product Hunt, Hacker News, AI sites via Browserbase"
          }
        }
      },
      {
        "validate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "visionCortexValidate",
            "args": {
              "run_id": "${ .discover.run_id }",
              "top_n": 10,
              "min_score": 40,
              "generate_summaries": true,
              "max_ideas_to_score": 15
            }
          },
          "then": "check_top_idea",
          "x-base44": {
            "title": "Validate & score with YC framework",
            "description": "Score up to 15 ideas (batched to avoid timeout), pick top 10, generate exhaustive summaries"
          }
        }
      },
      {
        "check_top_idea": {
          "switch": [
            {
              "when": "${ (.validate.top_10 // [])[0].id != null and (.validate.top_10 // [])[0].id != \"\" }",
              "then": "provision_top"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check if top idea exists",
            "description": "Branch if there is a #1 ranked idea to provision"
          }
        }
      },
      {
        "provision_top": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "visionCortexProvision",
            "args": {
              "idea_id": "${ (.validate.top_10 // [])[0].id }",
              "auto_advance": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Provision #1 idea to Auto Builder",
            "description": "Create AutoBuild record from the top-ranked idea"
          }
        }
      }
    ]
  },
  "name": "Vision Cortex Daily Cycle",
  "description": "Runs the Vision Cortex engine once every 24 hours: scrapes 4+ sources (Reddit, Product Hunt, Hacker News, AI directories, social media) via Browserbase to find 25 ideas, scores up to 15 per invocation (batched to avoid timeout) against the YC 10-key-question framework, selects the top 10, generates exhaustive build summaries, and provisions the #1 idea into the Auto Builder pipeline.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}