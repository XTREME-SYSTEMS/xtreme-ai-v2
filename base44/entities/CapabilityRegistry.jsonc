{
  "name": "CapabilityRegistry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "string"
    },
    "cost_class": {
      "type": "string",
      "enum": [
        "free",
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "speed_class": {
      "type": "string",
      "enum": [
        "instant",
        "minutes",
        "hours",
        "batch"
      ],
      "default": "minutes"
    },
    "validation_score": {
      "type": "number"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "failed"
      ],
      "default": "unverified"
    },
    "approval_requirement": {
      "type": "string",
      "enum": [
        "none",
        "preview",
        "production"
      ],
      "default": "none"
    },
    "owner": {
      "type": "string"
    },
    "fallback": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}