{
  "name": "SeoPage",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "target_keyword": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "h1": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "json_ld": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published"
    }
  },
  "required": [
    "slug",
    "target_keyword"
  ]
}