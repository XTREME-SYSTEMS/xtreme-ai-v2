    },
    "seo_score": {
      "type": "number"
    },
    "local_seo_score": {
      "type": "number"
    },
    "aeo_score": {
      "type": "number"
    },
    "conversion_score": {
      "type": "number"
    },
    "brand_score": {
      "type": "number"
    },
    "reputation_score": {
      "type": "number"
    },
    "social_score": {
      "type": "number"
    },
    "technical_score": {
      "type": "number"
    },
    "offer_score": {
      "type": "number"
    },
    "lead_capture_score": {
      "type": "number"
    },
    "overall_score": {
      "type": "number"
    },
