{
  "name": "SimulationResult",
  "type": "object",
  "description": "A Monte Carlo simulation result for a business model, strategy, or decision. The simulator is a laboratory, not a fortune teller \u2014 it runs probabilistic projections across time horizons (1 week to 15 years) and scenarios (baseline, conservative, expected, optimistic, adverse, black-swan). Every projection shows uncertainty. Every variable is editable. When a variable changes, prior results are preserved for comparison. The Digital Dominance simulation adds SEO traffic, domain authority, site count, keyword rankings, and market share projections alongside revenue/cost/profit.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "simulation_name": {
      "type": "string",
      "description": "Human-readable name for this simulation"
    },
    "simulation_type": {
      "type": "string",
      "enum": [
        "business_model",
        "strategy",
        "decision",
        "revenue",
        "market_entry",
        "product_launch",
        "cost_optimization",
        "growth",
        "digital_dominance"
      ],
      "default": "business_model"
    },
    "subject_id": {
      "type": "string",
      "description": "ID of the entity being simulated (AutoBuild, VisionCortexIdea, Market, etc.)"
    },
    "subject_type": {
      "type": "string",
      "description": "Entity type of the subject"
    },
    "input_variables": {
      "type": "object",
      "description": "The input variables used for this simulation run \u2014 customers, price, conversion, churn, CAC, LTV, margin, costs, sites per month, traffic per site, etc.",
      "properties": {
        "customers": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "conversion_rate": {
          "type": "number"
        },
        "churn_rate": {
          "type": "number"
        },
        "cac": {
          "type": "number"
        },
        "gross_margin": {
          "type": "number"
        },
        "monthly_cost": {
          "type": "number"
        },
        "ai_cost": {
          "type": "number"
        },
        "growth_rate": {
          "type": "number"
        },
        "sites_per_month": {
          "type": "number"
        },
        "avg_traffic_per_site": {
          "type": "number"
        },
        "avg_revenue_per_site": {
          "type": "number"
        },
        "domain_cost": {
          "type": "number"
        },
        "hosting_cost_per_site": {
          "type": "number"
        },
        "keywords_per_site": {
          "type": "number"
        },
        "market_share_target": {
          "type": "number"
        }
      }
    },
    "scenario": {
      "type": "string",
      "enum": [
        "baseline",
        "conservative",
        "expected",
        "optimistic",
        "adverse",
        "black_swan"
      ],
      "default": "expected",
      "description": "Which scenario assumption set was used"
    },
    "time_horizon": {
      "type": "string",
      "enum": [
        "1_week",
        "1_month",
        "3_months",
        "6_months",
        "12_months",
        "2_years",
        "3_years",
        "4_years",
        "5_years",
        "10_years",
        "15_years"
      ],
      "default": "12_months"
    },
    "iterations": {
      "type": "number",
      "default": 1000,
      "description": "Number of Monte Carlo iterations run"
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "e.g. 'month_1', 'year_1'"
          },
          "revenue_p50": {
            "type": "number"
          },
          "revenue_p10": {
            "type": "number"
          },
          "revenue_p90": {
            "type": "number"
          },
          "customers_p50": {
            "type": "number"
          },
          "customers_p10": {
            "type": "number"
          },
          "customers_p90": {
            "type": "number"
          },
          "cost_p50": {
            "type": "number"
          },
          "profit_p50": {
            "type": "number"
          },
          "profit_p10": {
            "type": "number"
          },
          "profit_p90": {
            "type": "number"
          },
          "traffic_p50": {
            "type": "number",
            "description": "Total monthly organic traffic across all sites"
          },
          "traffic_p10": {
            "type": "number"
          },
          "traffic_p90": {
            "type": "number"
          },
          "site_count_p50": {
            "type": "number",
            "description": "Total deployed sites"
          },
          "site_count_p10": {
            "type": "number"
          },
          "site_count_p90": {
            "type": "number"
          },
          "domain_authority_p50": {
            "type": "number",
            "description": "Average domain authority (0-100)"
          },
          "keywords_ranking_p50": {
            "type": "number",
            "description": "Total keywords ranking in top 10"
          },
          "market_share_p50": {
            "type": "number",
            "description": "Estimated market share percentage"
          }
        }
      },
      "description": "Probabilistic projections per period \u2014 p10/p50/p90 percentiles from the Monte Carlo distribution"
    },
    "summary": {
      "type": "object",
      "description": "Headline results",
      "properties": {
        "break_even_months": {
          "type": "number"
        },
        "expected_revenue_12m": {
          "type": "number"
        },
        "expected_profit_12m": {
          "type": "number"
        },
        "probability_of_success": {
          "type": "number"
        },
        "worst_case_loss": {
          "type": "number"
        },
        "best_case_gain": {
          "type": "number"
        },
        "expected_value": {
          "type": "number"
        },
        "total_sites_projected": {
          "type": "number",
          "description": "Total sites at horizon end (p50)"
        },
        "total_traffic_projected": {
          "type": "number",
          "description": "Total monthly traffic at horizon end (p50)"
        },
        "total_keywords_projected": {
          "type": "number",
          "description": "Total keywords ranking at horizon end (p50)"
        },
        "avg_domain_authority_projected": {
          "type": "number",
          "description": "Average DA at horizon end (p50)"
        },
        "market_share_projected": {
          "type": "number",
          "description": "Market share at horizon end (p50)"
        }
      }
    },
    "sensitivity_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variable": {
            "type": "string"
          },
          "impact": {
            "type": "number"
          },
          "direction": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_notes": {
      "type": "string"
    },
    "prior_result_id": {
      "type": "string"
    },
    "comparison_delta": {
      "type": "object",
      "properties": {
        "revenue_delta": {
          "type": "number"
        },
        "profit_delta": {
          "type": "number"
        },
        "traffic_delta": {
          "type": "number"
        },
        "site_count_delta": {
          "type": "number"
        },
        "changed_variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "default": "running"
    }
  },
  "required": [
    "simulation_name",
    "simulation_type",
    "scenario",
    "time_horizon"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}