{
  "name": "AgentPerformance",
  "type": "object",
  "description": "Tracks the demonstrated performance of each AI agent archetype in the Vision Cortex Council and autonomous system. Agents are scored on accuracy, usefulness, reasoning quality, source quality, prediction quality, implementation success, validation success, cost efficiency, reliability, collaboration, and failure recovery. Calibration is maintained \u2014 confidence is not rewarded, useful correct outcomes are. Used to weight council decisions by demonstrated performance, not personality.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "agent_name": {
      "type": "string",
      "description": "The agent/archetype name (e.g. 'chief_architect', 'contrarian', 'epistemic_auditor', 'systems_architect')"
    },
    "agent_type": {
      "type": "string",
      "enum": [
        "council_archetype",
        "autonomous_agent",
        "lead_engine_agent",
        "build_agent",
        "validation_agent"
      ],
      "default": "council_archetype"
    },
    "total_decisions": {
      "type": "number",
      "default": 0,
      "description": "Total decisions this agent has participated in"
    },
    "accuracy_score": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how often this agent's analysis was correct (verified by outcome)"
    },
    "usefulness_score": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how useful the agent's contributions were to the final decision"
    },
    "reasoning_quality": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 quality of logical reasoning"
    },
    "source_quality": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 quality of evidence/sources cited"
    },
    "prediction_quality": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 accuracy of predictions made (verified later)"
    },
    "implementation_success": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 success rate of implementations this agent proposed"
    },
    "validation_success": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 success rate of validations this agent performed"
    },
    "cost_efficiency": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 value delivered per credit/token spent"
    },
    "reliability": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how often the agent completes its task without failure"
    },
    "collaboration_score": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how well the agent integrates with other agents' work"
    },
    "failure_recovery": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how well the agent recovers from its own failures"
    },
    "long_term_outcome": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 outcomes measured weeks/months later, not just immediate"
    },
    "overall_score": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 composite weighted score used to weight council decisions"
    },
    "calibration": {
      "type": "number",
      "default": 50,
      "description": "0-100 \u2014 how well the agent's confidence matches its actual accuracy (Brier score derived)"
    },
    "recent_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "predicted": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "correct": {
            "type": "boolean"
          },
          "confidence_at_time": {
            "type": "number"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Recent verified outcomes \u2014 used to update scores and calibration"
    },
    "doctrine_updates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lessons learned that should inform this agent's future behavior"
    },
    "last_evaluated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "agent_name",
    "agent_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}