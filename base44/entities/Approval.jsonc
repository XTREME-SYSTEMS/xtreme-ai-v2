{
  "name": "Approval",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "requested_action": {
      "type": "string"
    },
    "pipeline_step": {
      "type": "string",
      "description": "Universal pipeline step key this approval gates (e.g. 'brand-kit', 'website'). Enables exact step matching."
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client this approval is assigned to. Used for row-level isolation."
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "default": "yellow"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "entity_type",
    "requested_action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}