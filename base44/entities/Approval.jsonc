{
  "name": "Approval",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "requested_action": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ],
      "default": "yellow"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "pending"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "entity_type",
    "requested_action"
  ]
}