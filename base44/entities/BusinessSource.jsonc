{
  "name": "BusinessSource",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "business_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "raw_reference": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "provenance": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "provider"
  ]
}