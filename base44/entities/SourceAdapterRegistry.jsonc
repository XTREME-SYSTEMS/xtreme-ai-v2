{
  "name": "SourceAdapterRegistry",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "source_name": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "api",
        "directory",
        "search",
        "rdap",
        "social",
        "government"
      ],
      "default": "api"
    },
    "access_method": {
      "type": "string"
    },
    "allowed_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rate_limit": {
      "type": "string"
    },
    "provenance_rules": {
      "type": "string"
    },
    "confidence_rules": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "mocked",
        "unavailable",
        "disabled"
      ],
      "default": "mocked"
    }
  },
  "required": [
    "source_name",
    "source_type"
  ]
}