{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "The subscription plan the user has purchased",
      "enum": [
        "free",
        "pro",
        "elite",
        "enterprise"
      ],
      "default": "free"
    },
    "has_paid": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}