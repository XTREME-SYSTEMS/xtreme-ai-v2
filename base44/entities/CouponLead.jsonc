{
  "name": "CouponLead",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "coupon_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "emailed",
        "redeemed"
      ],
      "default": "new"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "email"
  ]
}