{
  "name": "OnboardingSession",
  "type": "object",
  "description": "A business onboarding and editor project, with private draft storage and its own editor-agent conversation.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "session_id": {
      "type": "string",
      "description": "Deterministic session ID"
    },
    "user_email": {
      "type": "string",
      "description": "Owner email for isolation"
    },
    "project_name": {
      "type": "string",
      "maxLength": 160
    },
    "studio_conversation_id": {
      "type": "string"
    },
    "draft_file_uri": {
      "type": "string",
      "description": "Private HTML document edited by the studio agent"
    },
    "draft_revision": {
      "type": "integer",
      "default": 0
    },
    "draft_pack_id": {
      "type": "string",
      "description": "Original website pack opened in this project"
    },
    "status": {
      "type": "string",
      "enum": [
        "onboarding",
        "strategy_locked",
        "pack_pending",
        "pack_approved",
        "deployed",
        "mass_deploying",
        "complete"
      ],
      "default": "onboarding"
    },
    "current_step": {
      "type": "number",
      "default": 1
    },
    "answers": {
      "type": "object",
      "properties": {
        "business_name": {
          "type": "object"
        },
        "owner_name": {
          "type": "object"
        },
        "industry": {
          "type": "object"
        },
        "location": {
          "type": "object"
        },
        "services": {
          "type": "object"
        },
        "target_audience": {
          "type": "object"
        },
        "competitive_advantage": {
          "type": "object"
        },
        "budget": {
          "type": "object"
        }
      }
    },
    "locked_strategy_id": {
      "type": "string"
    },
    "approved_pack_id": {
      "type": "string"
    },
    "deployed_site_id": {
      "type": "string"
    },
    "mass_deploy_job_id": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}