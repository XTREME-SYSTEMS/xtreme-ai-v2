{
  "name": "OnboardingSession",
  "type": "object",
  "description": "The AI onboarding session \u2014 the entry point to the entire simplified pipeline. An AI assistant asks the user a series of questions about their business. Every answer triggers a background skip-trace that builds a full intelligence profile (business, owner, competitors, market, suppliers, adjacent trades, permits, properties). Once all questions are answered, the session moves to strategy lock, then GPT website generation, review, deploy, and mass deploy.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "session_id": {
      "type": "string",
      "description": "Deterministic session ID"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this session"
    },
    "status": {
      "type": "string",
      "enum": [
        "onboarding",
        "strategy_locked",
        "pack_pending",
        "pack_approved",
        "deployed",
        "mass_deploying",
        "complete"
      ],
      "default": "onboarding",
      "description": "Where in the 5-8 step flow this session is"
    },
    "current_step": {
      "type": "number",
      "default": 1,
      "description": "Which onboarding question the user is currently on"
    },
    "answers": {
      "type": "object",
      "description": "Map of question_key \u2192 { answer_text, skip_trace_id, answered_at }",
      "properties": {
        "business_name": {
          "type": "object"
        },
        "owner_name": {
          "type": "object"
        },
        "industry": {
          "type": "object"
        },
        "location": {
          "type": "object"
        },
        "services": {
          "type": "object"
        },
        "target_audience": {
          "type": "object"
        },
        "competitive_advantage": {
          "type": "object"
        },
        "budget": {
          "type": "object"
        }
      }
    },
    "locked_strategy_id": {
      "type": "string",
      "description": "ID of the LockedStrategy record once the strategy is locked"
    },
    "approved_pack_id": {
      "type": "string",
      "description": "ID of the approved GptPack once a mockup is approved"
    },
    "deployed_site_id": {
      "type": "string",
      "description": "ID of the DeployedSite once the single site is live"
    },
    "mass_deploy_job_id": {
      "type": "string",
      "description": "ID of the MassDeployJob if mass deployment was started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}