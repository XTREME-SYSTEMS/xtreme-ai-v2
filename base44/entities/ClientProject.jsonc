{
  "name": "ClientProject",
  "type": "object",
  "description": "Offloads creative work from the User record \u2014 stores all generated assets (vision, strategy, content, logo, brand, website, social, video) for a client's project, keyed by client email. One project per client.",
  "properties": {
    "client_email": {
      "type": "string",
      "description": "Email of the client who owns this project. Used for row-level isolation."
    },
    "business_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "sub_industry": {
      "type": "string"
    },
    "business_type": {
      "type": "string"
    },
    "business_stage": {
      "type": "string",
      "description": "new, rebrand, scale \u2014 controls which steps are shown"
    },
    "profile": {
      "type": "object",
      "description": "Full business profile from the onboarding wizard",
      "properties": {
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "primary_location": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "radius": {
          "type": "string"
        },
        "years_in_business": {
          "type": "string"
        },
        "industry_answers": {
          "type": "object"
        },
        "financial_intelligence": {
          "type": "object"
        },
        "logo_url": {
          "type": "string"
        },
        "gallery_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vision": {
      "type": "object",
      "description": "Generated vision document \u2014 mission, problem, target audience, long-term direction, success metrics, core values, value proposition, market opportunity. Produced by generateVision. Mandatory before building begins.",
      "properties": {
        "mission": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "long_term_vision": {
          "type": "string"
        },
        "success_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "core_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_proposition": {
          "type": "string"
        },
        "market_opportunity": {
          "type": "string"
        },
        "approved": {
          "type": "boolean",
          "default": false
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "strategy": {
      "type": "object",
      "description": "Generated strategy document \u2014 competitive positioning, go-to-market, revenue model, pricing, acquisition channels, roadmap, risks, resources, differentiation, partnerships. Produced by generateStrategy from the approved vision. Mandatory before building begins.",
      "properties": {
        "competitive_positioning": {
          "type": "string"
        },
        "go_to_market": {
          "type": "string"
        },
        "revenue_model": {
          "type": "string"
        },
        "pricing_strategy": {
          "type": "string"
        },
        "acquisition_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roadmap": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "resources": {
          "type": "string"
        },
        "differentiation": {
          "type": "string"
        },
        "partnerships": {
          "type": "string"
        },
        "approved": {
          "type": "boolean",
          "default": false
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "content_templates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chosen_content_template": {
      "type": "string"
    },
    "content_templates_chosen": {
      "type": "boolean",
      "default": false
    },
    "logo_options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chosen_logo_url": {
      "type": "string"
    },
    "brand_packs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chosen_brand_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website_content": {
      "type": "object"
    },
    "website_images": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "chosen_website_layout": {
      "type": "string"
    },
    "chosen_palette": {
      "type": "string"
    },
    "design_packs_chosen": {
      "type": "boolean",
      "default": false
    },
    "social_media_pack": {
      "type": "object"
    },
    "social_media_chosen": {
      "type": "boolean",
      "default": false
    },
    "video_pack": {
      "type": "object"
    },
    "video_chosen": {
      "type": "boolean",
      "default": false
    },
    "enhancements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enhancements_total": {
      "type": "number",
      "default": 0
    },
    "enhancements_chosen": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "onboarding",
        "generating",
        "review",
        "approved",
        "launched"
      ],
      "default": "draft"
    },
    "current_step": {
      "type": "string"
    },
    "visited_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Portal step paths the client has visited/completed (server-persisted, replaces per-device localStorage coach:done keys)."
    }
  },
  "required": [
    "client_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}