{
  "name": "QATestRun",
  "type": "object",
  "description": "A single execution of the QA Agent or Humanized Test Agent. Tracks which system was tested (admin, employee portal, client portal, public), how many pages/buttons/functions were touched, screenshots taken, the overall health score, and a summary of flaws and recommendations. Created by qaTestSystem (QA Agent) and humanizedTestPortal (Humanized Test Agent).",
  "properties": {
    "agent_type": {
      "type": "string",
      "enum": [
        "qa_agent",
        "humanized_test"
      ],
      "description": "Which agent ran: qa_agent = systematic button/function tester, humanized_test = real-user journey simulator"
    },
    "target_system": {
      "type": "string",
      "enum": [
        "admin",
        "employee_portal",
        "client_portal",
        "public",
        "full_system"
      ],
      "description": "Which system was tested"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "complete",
        "failed"
      ],
      "default": "queued"
    },
    "pages_tested": {
      "type": "number",
      "default": 0,
      "description": "Number of pages navigated to and tested"
    },
    "buttons_clicked": {
      "type": "number",
      "default": 0,
      "description": "Number of buttons/links clicked during the test"
    },
    "functions_tested": {
      "type": "number",
      "default": 0,
      "description": "Number of backend functions called and verified"
    },
    "screenshots_taken": {
      "type": "number",
      "default": 0,
      "description": "Number of screenshots captured during the test"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Overall system health score (0-100). 100 = no flaws, 0 = system broken."
    },
    "flaws_count": {
      "type": "number",
      "default": 0,
      "description": "Total number of flaws/issues found"
    },
    "critical_count": {
      "type": "number",
      "default": 0,
      "description": "Number of critical-severity flaws"
    },
    "recommendations_count": {
      "type": "number",
      "default": 0,
      "description": "Number of enhancement recommendations generated"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary of the test run \u2014 key findings, top flaws, and recommended enhancements"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "default": 0,
      "description": "How long the test ran in milliseconds"
    },
    "triggered_by": {
      "type": "string",
      "description": "Who or what triggered this run (manual, workflow, admin email)"
    },
    "error": {
      "type": "string",
      "description": "Error message if the run failed"
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "agent_type",
    "target_system"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}