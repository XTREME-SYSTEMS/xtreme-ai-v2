{
  "name": "SystemPrompt",
  "type": "object",
  "description": "A curated prompt in the System Optimization Prompt Library. Each prompt is designed to make the system self-optimizing, self-healing, self-hardening, self-maintaining, and self-managing. Prompts are categorized by purpose (audit, heal, harden, optimize, manage, launch) and tagged for use by the System Operator agent and daily management workflows.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "title": {
      "type": "string",
      "description": "Prompt title / name"
    },
    "category": {
      "type": "string",
      "enum": [
        "audit",
        "heal",
        "harden",
        "optimize",
        "manage",
        "launch",
        "preflight",
        "daily_ops"
      ],
      "description": "What this prompt is for"
    },
    "prompt_text": {
      "type": "string",
      "description": "The full prompt text \u2014 designed to be injected into an LLM call or agent system prompt"
    },
    "target_system": {
      "type": "string",
      "description": "Which system area this prompt targets (auth, payments, auto_builder, lead_engine, visualizer, xps_catalog, marketing, full_system)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "How important this prompt is for launch readiness"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "expected_output": {
      "type": "string",
      "description": "What the prompt should produce when executed"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 50
    }
  },
  "required": [
    "title",
    "category",
    "prompt_text"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}