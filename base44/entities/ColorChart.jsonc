{
  "name": "ColorChart",
  "type": "object",
  "description": "Real manufacturer color chart data for the floor visualizer. Each entry is a specific color from a flooring system (metallic, flake, quartz, solid, glitter, dye_stain) with the manufacturer product code, hex color, swatch image URL, collection name, sheen level, stock status, and display rank. Seeded from real XPS (Xtreme Polishing Systems) and Ameripolish product catalogs.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "system": {
      "type": "string",
      "enum": [
        "metallic",
        "flake",
        "quartz",
        "solid",
        "glitter",
        "dye_stain"
      ],
      "description": "Flooring system category this color belongs to"
    },
    "color_name": {
      "type": "string",
      "description": "Display name of the color (e.g. 'Metallic Silver', 'Tidal Wave')"
    },
    "code": {
      "type": "string",
      "description": "Manufacturer product code (e.g. 'CM-101', 'FB-807', 'XPS-0300')"
    },
    "hex": {
      "type": "string",
      "description": "Hex color code for the swatch (e.g. '#C8C9CB')"
    },
    "image_url": {
      "type": "string",
      "description": "URL to the manufacturer's swatch image"
    },
    "collection": {
      "type": "string",
      "description": "Collection name (e.g. 'Liquid Metallic', 'Powder Metallic', 'In-Stock Collection')"
    },
    "sheen": {
      "type": "string",
      "enum": [
        "High Gloss",
        "Satin",
        "Semi-Gloss",
        "Matte",
        "Textured"
      ],
      "description": "Finish sheen level"
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Whether this color is currently in stock"
    },
    "rank": {
      "type": "number",
      "default": 50,
      "description": "Display rank (lower = shown first)"
    }
  },
  "required": [
    "system",
    "color_name",
    "code",
    "hex"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}