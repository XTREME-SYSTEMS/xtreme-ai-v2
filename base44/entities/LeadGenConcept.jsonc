{
  "name": "LeadGenConcept",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "business_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "customer_problem": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "tool_type": {
      "type": "string"
    },
    "value_before_gate": {
      "type": "string"
    },
    "lead_event": {
      "type": "string"
    },
    "seo_opportunity": {
      "type": "string"
    },
    "aeo_opportunity": {
      "type": "string"
    },
    "build_complexity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "built"
      ],
      "default": "draft"
    }
  },
  "required": [
    "business_id",
    "name"
  ]
}