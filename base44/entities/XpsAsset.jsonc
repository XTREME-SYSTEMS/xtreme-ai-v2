{
  "name": "XpsAsset",
  "type": "object",
  "description": "Real Xtreme Polishing Systems (XPS) assets scraped from xtremepolishingsystems.com (Shopify API), polishedconcreteuniversity.com, and their social media channels (Instagram, YouTube, Facebook, TikTok). Categories include products (epoxy, coatings, tools), equipment (grinders, polishers, vacuums), color charts (metallic, flake, quartz, solid, glitter, dye stain), brand assets, marketing images, marketing videos, social posts, training videos, and testimonials. Used by the auto builder to generate authentic, brand-specific content instead of generic placeholders. Ingested by the ingestXpsCatalog backend function.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "enum": [
        "product",
        "equipment",
        "color_chart",
        "logo",
        "brand",
        "marketing_image",
        "marketing_video",
        "social_post",
        "testimonial",
        "training_video",
        "podcast"
      ],
      "description": "Asset category \u2014 determines how the auto builder uses it"
    },
    "name": {
      "type": "string",
      "description": "Display name of the product, equipment, color, video, or asset"
    },
    "sku": {
      "type": "string",
      "description": "Manufacturer product SKU or color code (for products and color charts)"
    },
    "price": {
      "type": "string",
      "description": "Price as displayed on the site (e.g. '$375.00', 'From $93.05')"
    },
    "image_url": {
      "type": "string",
      "description": "Primary image URL (product photo, equipment photo, color swatch, marketing image, video thumbnail)"
    },
    "video_url": {
      "type": "string",
      "description": "Video URL (YouTube link, Instagram reel link)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL for videos"
    },
    "source_url": {
      "type": "string",
      "description": "URL where this asset was found (product page, color chart page, social post URL)"
    },
    "source_platform": {
      "type": "string",
      "enum": [
        "website",
        "instagram",
        "youtube",
        "facebook",
        "tiktok",
        "linkedin",
        "podcast"
      ],
      "default": "website",
      "description": "Which platform this asset came from"
    },
    "brand": {
      "type": "string",
      "description": "Brand name (e.g. 'Xtreme Polishing Systems', 'Ameripolish', 'Husqvarna', 'Metabo', 'Polished Concrete University')"
    },
    "product_type": {
      "type": "string",
      "description": "Product type grouping (e.g. 'epoxy_coating', 'grinder', 'polisher', 'densifier', 'sealer', 'flake', 'quartz', 'tooling', 'metallic', 'dye_stain')"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags (e.g. 'metallic', 'flake', 'garage', 'commercial', 'residential')"
    },
    "system_relevance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which floor systems this asset is relevant to (metallic, flake, quartz, solid, glitter, dye_stain, polished, repair)"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Typical use cases (e.g. 'garage floor', 'commercial kitchen', 'showroom', 'warehouse')"
    },
    "specifications": {
      "type": "object",
      "description": "Product or color specifications (hex, coverage, cure time, sheen, collection, etc.)",
      "properties": {
        "hex": {
          "type": "string"
        },
        "sheen": {
          "type": "string"
        },
        "collection": {
          "type": "string"
        },
        "in_stock": {
          "type": "boolean"
        },
        "rank": {
          "type": "number"
        },
        "coverage": {
          "type": "string"
        },
        "cure_time": {
          "type": "string"
        },
        "voc": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        }
      }
    },
    "duration_seconds": {
      "type": "number",
      "description": "Video duration in seconds (for videos)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is active and available for use"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this asset was last ingested/scraped"
    }
  },
  "required": [
    "category",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}