{
  "name": "GenerationJob",
  "type": "object",
  "properties": {
    "market_id": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "seo",
        "pricing",
        "competitors",
        "images",
        "full"
      ],
      "default": "full"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "default": "queued"
    },
    "result_summary": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "market_id",
    "job_type"
  ]
}