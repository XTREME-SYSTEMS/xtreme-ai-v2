{
  "name": "GptPack",
  "type": "object",
  "description": "A brand asset pack received from GPT via the ingestPack sync endpoint. Packs land as pending review and are grouped in sets of 3 versions (version_group_id) for each asset type (kind). Nothing goes live until the user approves.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "name": {
      "type": "string",
      "description": "Name/label for this pack"
    },
    "kind": {
      "type": "string",
      "enum": [
        "web_pack",
        "brand_pack",
        "marketing_pack",
        "social_pack",
        "video_pack",
        "logo_pack"
      ],
      "default": "web_pack",
      "description": "What kind of asset this is"
    },
    "preview_html": {
      "type": "string",
      "description": "Full HTML of the mockup"
    },
    "brand_tokens": {
      "type": "string",
      "description": "JSON string of brand tokens"
    },
    "source": {
      "type": "string",
      "default": "gpt_sync"
    },
    "submitted_by_label": {
      "type": "string",
      "default": "GPT"
    },
    "session_id": {
      "type": "string",
      "description": "The OnboardingSession this pack is for"
    },
    "user_email": {
      "type": "string",
      "description": "Owner email for RLS isolation"
    },
    "version_number": {
      "type": "number",
      "default": 1,
      "description": "Version 1, 2, or 3 within the group"
    },
    "version_group_id": {
      "type": "string",
      "description": "Groups 3 versions of the same asset type together"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "deployed"
      ],
      "default": "pending"
    },
    "review_notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "deployed_url": {
      "type": "string"
    },
    "deployed_site_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "kind",
    "preview_html",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}